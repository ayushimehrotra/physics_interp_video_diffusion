.venv/
outputs/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.mp4
*.safetensors
*.pt
.DS_Store

# Generated Kubric datasets: rendered frames and masks are large (a 50-scene pilot is
# ~540MB) and reproducible from a seed via datasets/run_batch.py. The small
# validation artifacts are kept, since they are the evidence the set was checked.
# (excluding pilot/* rather than pilot/ so the _validation negation can still apply --
# git will not descend into an excluded directory to re-include anything inside it)
datasets/pilot/*
!datasets/pilot/_validation/
datasets/*/scene_*/

# Superseded experiments, archived 2026-09-21. See old_experiments/MANIFEST.txt. Nothing deleted.
old_experiments/*
!old_experiments/MANIFEST.txt
!old_experiments/scripts/

# Captured activations live under outputs/ (ignored above): large, reproducible from a capture run.

# Claude Code worktrees and local settings
.claude/worktrees/

# Rendered clips in plan-driven sets (named <cell>_seed<N>, not scene_*); keep plan/build log
datasets/*/*_seed*/
datasets/*/*.npz
# Rendered clips in the KE factor set (named <family><group>_k<level>, e.g. M000_k+0)
datasets/*/[MS][0-9][0-9][0-9]_k*/
